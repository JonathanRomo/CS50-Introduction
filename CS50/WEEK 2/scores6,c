#include <studio.h>
#include <cs50.h>

int main (void)
{
    int scores[3];
    for (int i = 0; i < 3; i++)
    {
        scores[i] = get_int("Score: ");
    }
    // defines an array size and each position value by a loop
    printf("Average: %f/n", (scores[0] + scores[1] + scores[2]) / (float) 3);
}